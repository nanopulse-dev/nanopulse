FROM ghcr.io/cross-rs/aarch64-unknown-linux-musl:main

ENV SX1302_VERSION=V2.1.0r9

ENV HAL_ARCH=arm
ENV MUSL_PREFIX=aarch64-unknown-linux-musl

RUN apt-get update && \
    apt-get --assume-yes install \
    git

RUN mkdir /hal

RUN echo "Building sx1302 HAL" && \
    cd /hal && \
    git clone https://github.com/brocaar/sx1302_hal.git -b $SX1302_VERSION && \
    cd /hal/sx1302_hal && \
    ARCH=$ARCH CROSS_COMPILE=$MUSL_PREFIX- make libloragw && \
    mkdir -p /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include && \
    ln -s /hal/sx1302_hal/libloragw/inc /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include/libloragw-sx1302 && \
    ln -s /hal/sx1302_hal/libloragw/libloragw.a /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/lib/libloragw-sx1302.a && \
    cp /hal/sx1302_hal/libtools/inc/* /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/include && \
    cp /hal/sx1302_hal/libtools/*.a /x-tools/$MUSL_PREFIX/$MUSL_PREFIX/sysroot/lib
